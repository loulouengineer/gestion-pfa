spring.application.name=projetSpring

# Database — créer la base pfa_db dans MySQL avant de démarrer
spring.datasource.url=jdbc:mysql://localhost:3306/pfa_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
spring.datasource.username=root
spring.datasource.password=YOUR_PASSWORD
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.database-platform=org.hibernate.dialect.MySQLDialect
spring.jpa.open-in-view=false

# Ollama (recommandation IA)
ollama.url=http://localhost:11434
ollama.model=gemma2:2b

# JWT
jwt.secret=pfaManagerSecretKey2024VeryLongAndSecureKeyForJWT
jwt.expiration=86400000

server.port=8085

app.frontend-url=http://localhost:5173

# Email SMTP (optionnel — pour reset mot de passe)
# spring.mail.host=smtp.gmail.com
# spring.mail.port=587
# spring.mail.username=your-email@gmail.com
# spring.mail.password=your-app-password
# spring.mail.from=your-email@gmail.com
